# Режим разработки: 1 - включить DEBUG, 0 - боевой режим
DEBUG=1
# В боевом режиме SECRET_KEY обязателен. Сгенерировать:
# python -c "from django.core.management.utils import get_random_secret_key as g; print(g())"
SECRET_KEY=change-me
ALLOWED_HOSTS=localhost,127.0.0.1
# Адрес сайта (используется в ссылках из писем)
SITE_URL=http://localhost:8000

# PostgreSQL. Если POSTGRES_DATABASE пуст, используется SQLite (db.sqlite3)
POSTGRES_DATABASE=
POSTGRES_USER=
POSTGRES_PASSWORD=
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# Redis (кэш, сессии, брокер Celery), например redis://localhost:6379/0
# Если пуст: локальный кэш, а задачи Celery выполняются сразу в процессе сайта
REDIS_URL=

# Почта. Если EMAIL_HOST_USER пуст, письма выводятся в консоль
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
# Письмо при взаимном одобрении: 1 - отправлять, 0 - только уведомление на сайте
MUTUAL_EMAIL_ENABLED=0
